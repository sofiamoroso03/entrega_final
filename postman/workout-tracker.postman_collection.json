{
  "info": {
    "name": "Workout Tracker API",
    "description": "Colección de endpoints para el Trabajo Integrador Final (Auth, Routines y Sessions).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "routineId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "verifyToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Sofia\",\n  \"email\": \"tu_correo_de_prueba@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/verify-email/{{verifyToken}}"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tu_correo_de_prueba@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Routines",
      "item": [
        {
          "name": "Create Routine",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Intervalos de velocidad\",\n  \"category\": \"running\",\n  \"intensity\": \"alta\",\n  \"targetDuration\": 35,\n  \"description\": \"Entrada en calor + pasadas de velocidad + vuelta a la calma\"\n}"
            },
            "url": "{{baseUrl}}/api/routines"
          }
        },
        {
          "name": "Get All Routines",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/routines"
          }
        },
        {
          "name": "Get Routine By ID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/routines/{{routineId}}"
          }
        },
        {
          "name": "Update Routine",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetDuration\": 40,\n  \"intensity\": \"media\"\n}"
            },
            "url": "{{baseUrl}}/api/routines/{{routineId}}"
          }
        },
        {
          "name": "Delete Routine",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/routines/{{routineId}}"
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fondo en el parque\",\n  \"date\": \"2026-11-24\",\n  \"durationMinutes\": 30,\n  \"distanceKm\": 5.2,\n  \"effort\": 7,\n  \"notes\": \"Buen ritmo, clima agradable\",\n  \"routineId\": \"{{routineId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/sessions"
          }
        },
        {
          "name": "Get All Sessions (con populate)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/sessions"
          }
        },
        {
          "name": "Get Sessions Filtered By Routine",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/sessions?routineId={{routineId}}"
          }
        },
        {
          "name": "Get Session By ID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Update Session",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationMinutes\": 35,\n  \"effort\": 8,\n  \"notes\": \"Sumé 5 minutos al final\"\n}"
            },
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Delete Session",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}"
          }
        }
      ]
    }
  ]
}